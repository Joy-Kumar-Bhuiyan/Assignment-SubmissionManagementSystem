# PostgreSQL Database Connection String
ConnectionStrings__DefaultConnection="Host=localhost;Database=YourDatabase;Username=YourUsername;Password=YourPassword"

# JWT Token Security Settings
Jwt__Key="ReplaceWithAtLeast32BytesOfCryptographicallyRandomData"
Jwt__Issuer="AssignmentManagementSystem"
Jwt__Audience="AssignmentManagementSystemUsers"
Jwt__ExpiryMinutes=60

# Trusted frontend origins (add more with __1, __2, and so on)
Cors__AllowedOrigins__0="http://localhost:5173"

# Keep both disabled in production unless deliberately required
Database__MigrateOnStartup=false
SeedData__Enabled=false
SeedData__AdminPassword="ReplaceWithAStrongUniquePassword"
SeedData__TeacherPassword="ReplaceWithAStrongUniquePassword"
SeedData__StudentPassword="ReplaceWithAStrongUniquePassword"

# Optional when the frontend and API are hosted on different origins
VITE_API_BASE_URL="https://localhost:5001/api"

# File Upload Settings
MaxFileSizeMB=10
